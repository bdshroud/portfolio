  <!-- ===== ABOUT SECTION ===== -->
  <section class="section about" id="about">
    <div class="container">
      <div class="section-header">
        <p class="section-label">Get to Know Me</p>
        <h2 class="section-title">About <span class="accent">Me</span></h2>
        <div class="section-line"></div>
      </div>

      <div class="about-grid">
        <div class="about-image-col">
          <div class="about-image-frame">
            <img src="images/me.jpg" alt="Mohammad Yasin working" onerror="this.src='https://avatars.githubusercontent.com/u/67956315?v=4'" />
            <div class="about-image-decor"></div>
          </div>
          <div class="about-stats">
            <div class="stat-item">
              <span class="stat-num">5+</span>
              <span class="stat-text">Years Experience</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">61+</span>
              <span class="stat-text">Projects Done</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">Open</span>
              <span class="stat-text">For Hire</span>
            </div>
          </div>
        </div>

        <div class="about-content-col">
          <h3 class="about-sub">Full Stack & AI Software Developer</h3>
          <p class="about-text">
            Hi there! I'm <strong>Mohammad Yasin</strong>, a professional Full Stack &amp; AI Software Developer based in Bangladesh. 
            I provide custom AI software and modern web development services, and 
            work with clients globally via <a href="https://next-gentech.co.uk" target="_blank">next-gentech.co.uk</a>.
          </p>
          <p class="about-text">
            I specialize in building end-to-end web applications and AI-powered solutions that solve real-world problems.
            From architecting robust backend APIs to crafting intuitive frontends — I care deeply about code quality, 
            performance, and delivering value to clients.
          </p>
          <p class="about-text">
            With over 61 public repositories on GitHub and experience across TypeScript, JavaScript, React, Node.js, 
            and AI integration, I'm always pushing the boundaries of what's possible on the web.
          </p>

          <div class="about-tags">
            <span class="tag"><i class="fas fa-robot"></i> AI/ML</span>
            <span class="tag"><i class="fas fa-code"></i> Open Source</span>
            <span class="tag"><i class="fas fa-globe"></i> Bangladesh</span>
            <span class="tag"><i class="fas fa-server"></i> Backend</span>
            <span class="tag"><i class="fas fa-paint-brush"></i> UI Design</span>
            <span class="tag"><i class="fas fa-rocket"></i> Startups</span>
          </div>

          <div class="about-cta">
            <a href="#contact" class="btn btn-primary">
              <i class="fas fa-envelope"></i> Let's Talk
            </a>
            <a href="Resume.pdf" class="btn btn-ghost" download>
              <i class="fas fa-file-pdf"></i> My Resume
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

