  <!-- ===== PROJECTS SECTION ===== -->
  <section class="section projects" id="projects">
    <div class="container">
      <div class="section-header">
        <p class="section-label">What I've Built</p>
        <h2 class="section-title">My <span class="accent">Projects</span></h2>
        <div class="section-line"></div>
      </div>

      <div class="projects-filter">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="fullstack">Full Stack</button>
        <button class="filter-btn" data-filter="frontend">Frontend</button>
        <button class="filter-btn" data-filter="backend">Backend</button>
      </div>

      <div class="projects-grid">

        <!-- Project 1 -->
        <div class="project-card" data-category="fullstack">
          <div class="project-image">
            <img src="images/project1.png" alt="Wanderlust Travel App" onerror="this.src='https://placehold.co/600x400/6c63ff/ffffff?text=Wanderlust'" />
            <div class="project-overlay">
              <a href="pages/project1.html" class="overlay-btn">
                <i class="fas fa-eye"></i> Live Demo
              </a>
            </div>
          </div>
          <div class="project-body">
            <div class="project-tags">
              <span>TypeScript</span><span>React</span><span>Node.js</span>
            </div>
            <h3 class="project-title">Wanderlust — Travel Platform</h3>
            <p class="project-desc">A full-stack travel booking platform with real-time listings, user authentication, and Vercel deployment. Built with TypeScript and modern web technologies.</p>
            <div class="project-actions">
              <a href="pages/project1.html" class="btn btn-primary btn-sm">
                <i class="fas fa-info-circle"></i> Live Demo
              </a>
              <a href="https://github.com/bdshroud/b14-wanderlust-client" target="_blank" class="btn btn-ghost btn-sm">
                <i class="fab fa-github"></i> GitHub
              </a>
            </div>
