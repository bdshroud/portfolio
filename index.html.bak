  <!-- ===== HERO SECTION ===== -->
  <section class="hero" id="home">
    <div class="hero-bg-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>
    <div class="container hero-container">
      <div class="hero-content">
        <p class="hero-greeting">👋 Hello, I'm</p>
        <h1 class="hero-name">Mohammad Yasin</h1>
        <div class="hero-typewriter">
          <span class="typewriter-prefix">I'm a </span>
          <span class="typewriter-text" id="typewriter"></span>
          <span class="typewriter-cursor">|</span>
        </div>
        <p class="hero-description">
          I build professional Full Stack &amp; AI-powered software solutions.
          Passionate about custom AI software, clean architecture, and delivering real-world digital products.
        </p>

        <div class="hero-cta">
          <a href="Resume.pdf" class="btn btn-primary" download="Mohammad_Yasin_Resume.pdf">
            <i class="fas fa-download"></i> Download Resume
          </a>
          <a href="#projects" class="btn btn-outline">
            <i class="fas fa-eye"></i> View My Work
          </a>
        </div>

        <div class="hero-socials">
          <a href="https://github.com/bdshroud" target="_blank" rel="noopener" class="social-link" aria-label="GitHub">
            <i class="fab fa-github"></i>
          </a>
          <a href="https://next-gentech.co.uk" target="_blank" rel="noopener" class="social-link" aria-label="Website">
            <i class="fas fa-globe"></i>
          </a>
          <a href="https://twitter.com/bdShroud" target="_blank" rel="noopener" class="social-link" aria-label="Twitter/X">
            <i class="fab fa-x-twitter"></i>
          </a>
          <a href="mailto:business.bdshroud@gmail.com" class="social-link" aria-label="Email">
            <i class="fas fa-envelope"></i>
          </a>
        </div>
      </div>

      <div class="hero-image-wrapper">
        <div class="hero-image-ring ring-1"></div>
        <div class="hero-image-ring ring-2"></div>
        <div class="hero-image-ring ring-3"></div>
        <div class="hero-photo">
          <img src="images/me.jpg" alt="Mohammad Yasin - Full Stack & AI Developer" onerror="this.src='https://avatars.githubusercontent.com/u/67956315?v=4'" />
        </div>
        <div class="hero-badge badge-exp">
          <span class="badge-num">5+</span>
          <span class="badge-label">Years Exp.</span>
        </div>
        <div class="hero-badge badge-proj">
          <span class="badge-num">61+</span>
          <span class="badge-label">Projects</span>
        </div>
      </div>
    </div>

    <a href="#about" class="scroll-down" aria-label="Scroll down">
      <div class="scroll-mouse">
        <div class="scroll-wheel"></div>
      </div>
    </a>
